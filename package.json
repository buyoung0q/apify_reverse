{
  "name": "pocket-crawler",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Personal local scraping MCP server for Codex and Claude",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node mcp-server.js",
    "mcp": "node mcp-server.js",
    "config": "node scripts/connection-config.mjs",
    "test:mcp-live": "node tests/mcp-live.mjs",
    "ui": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.mjs",
    "check": "node --check mcp-server.js && node --check lib/mcp-store.js && node --check server.js && node --check lib/crawler.js && node --check lib/store.js && node --check public/app.js",
    "install:browser": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "playwright": "^1.56.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.25.76"
  }
}
